# ==============================================================================
# AAROGYA HOSPITAL MONOREPO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Hospital Branding & General Config
HOSPITAL_NAME="Aarogya Multi-Specialty Hospital"
HOSPITAL_TAGLINE="Compassionate Care, Advanced Medical Excellence"
HOSPITAL_PHONE="+91 80 4000 0000"
HOSPITAL_EMERGENCY_HOTLINE="1066"
HOSPITAL_EMAIL="support@aarogyahospital.example.com"
HOSPITAL_ADDRESS="Plot 42, Health City, Sector 5, Bengaluru, Karnataka 560100, India"

# Server Ports
PORT=5000
NODE_ENV=development
CLIENT_WEB_URL="http://localhost:3000"
CLIENT_ADMIN_URL="http://localhost:3001"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aarogya_hospital?schema=public"

# Authentication & Security
JWT_SECRET="aarogya-super-secure-jwt-secret-min-32-chars-long-key-12345"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="aarogya-secure-cookie-secret-key-67890"

# Razorpay Payment Gateway (India)
RAZORPAY_KEY_ID="rzp_test_YourRazorpayKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Secure Storage for Medical Records / Reports (Cloudinary or AWS S3)
STORAGE_PROVIDER="local" # Options: local | s3 | cloudinary
# If AWS S3 (Private Bucket with Pre-Signed URLs):
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1" # Mumbai region for India DPDP compliance
AWS_S3_BUCKET_NAME="aarogya-secure-health-records"
# If Cloudinary:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Communications & Notifications (India SMS / WhatsApp / Email)
# MSG91 / Twilio for SMS & WhatsApp:
SMS_PROVIDER="mock" # Options: mock | msg91 | twilio
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="AAROGY"
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""

# Email Service (Resend or SMTP):
EMAIL_PROVIDER="mock" # Options: mock | resend | smtp
RESEND_API_KEY=""
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@aarogyahospital.example.com"

# DPDP Act 2023 Compliance
DATA_RETENTION_YEARS=7
DATA_PROTECTION_OFFICER_EMAIL="dpo@aarogyahospital.example.com"
